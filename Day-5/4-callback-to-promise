// ==================================================
// 1. WHAT IS A CALLBACK?
// ==================================================

/*
A callback is a function passed as an argument
to another function.

The receiving function calls it when needed.
*/

function greet(name, callback) {
    console.log("Hello " + name);

    callback();
}

function sayWelcome() {
    console.log("Welcome!");
}

greet("Neji", sayWelcome);

/*
OUTPUT:
Hello Neji
Welcome!
*/


// ==================================================
// 2. CALLBACK-BASED ASYNCHRONOUS FUNCTION
// ==================================================

/*
Here, setTimeout simulates an asynchronous operation.

The callback executes after 2 seconds.
*/

function getUser(callback) {

    setTimeout(() => {

        const user = {
            id: 1,
            name: "Neji"
        };

        callback(user);

    }, 2000);
}

getUser((user) => {
    console.log(user);
});

/*
OUTPUT AFTER 2 SECONDS:
{ id: 1, name: "Neji" }
*/


// ==================================================
// 3. WHAT IS CALLBACK HELL?
// ==================================================

/*
Callback hell happens when multiple callbacks
are nested inside one another.

It makes code difficult to read and maintain.
*/

function getUserData(callback) {

    setTimeout(() => {

        console.log("User data received");

        callback();

    }, 1000);
}

function getOrders(callback) {

    setTimeout(() => {

        console.log("Orders received");

        callback();

    }, 1000);
}

function getPayment(callback) {

    setTimeout(() => {

        console.log("Payment received");

        callback();

    }, 1000);
}

getUserData(() => {

    getOrders(() => {

        getPayment(() => {

            console.log("Process completed");

        });

    });

});

/*
OUTPUT:
User data received
Orders received
Payment received
Process completed
*/


// ==================================================
// 4. CONVERTING CALLBACK INTO A PROMISE
// ==================================================

/*
Instead of accepting a callback,
we return a Promise.

resolve() is used when the operation succeeds.
reject() is used when the operation fails.
*/

function getUserPromise() {

    return new Promise((resolve, reject) => {

        setTimeout(() => {

            const user = {
                id: 1,
                name: "Neji"
            };

            resolve(user);

        }, 2000);

    });
}

getUserPromise()
    .then((user) => {
        console.log(user);
    })
    .catch((error) => {
        console.log(error);
    });

/*
OUTPUT AFTER 2 SECONDS:
{ id: 1, name: "Neji" }
*/


// ==================================================
// 5. CONVERTING CALLBACK HELL INTO PROMISE CHAINING
// ==================================================

function getUser() {

    return new Promise((resolve) => {

        setTimeout(() => {
            console.log("User data received");
            resolve();
        }, 1000);

    });
}

function getOrders() {

    return new Promise((resolve) => {

        setTimeout(() => {
            console.log("Orders received");
            resolve();
        }, 1000);

    });
}

function getPayment() {

    return new Promise((resolve) => {

        setTimeout(() => {
            console.log("Payment received");
            resolve();
        }, 1000);

    });
}

getUser()
    .then(() => {
        return getOrders();
    })
    .then(() => {
        return getPayment();
    })
    .then(() => {
        console.log("Process completed");
    })
    .catch((error) => {
        console.log(error);
    });

/*
OUTPUT:
User data received
Orders received
Payment received
Process completed
*/


// ==================================================
// 6. USING ASYNC/AWAIT
// ==================================================

/*
async/await makes asynchronous code
look more like normal synchronous code.

await waits for a Promise to settle.
*/

async function processData() {

    await getUser();

    await getOrders();

    await getPayment();

    console.log("All tasks completed");

}

processData();

/*
OUTPUT:
User data received
Orders received
Payment received
All tasks completed
*/


// ==================================================
// 7. ERROR HANDLING
// ==================================================

function checkUser() {

    return new Promise((resolve, reject) => {

        setTimeout(() => {

            const success = false;

            if (success) {
                resolve("User found");
            } else {
                reject("User not found");
            }

        }, 1000);

    });

}

checkUser()
    .then((result) => {
        console.log(result);
    })
    .catch((error) => {
        console.log("Error:", error);
    });

/*
OUTPUT:
Error: User not found
*/


